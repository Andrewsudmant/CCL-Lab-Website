{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-conversation-cluster.schema.json",
  "title": "Current Conversations cluster",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster_id", "slug", "public_title", "discussion_statement", "date_first_observed", "date_most_recently_observed", "principal_source_id", "linked_source_ids", "primary_theme", "secondary_themes", "geographies", "source_environments", "principal_source_role", "summary", "reason_for_relevance", "limitations", "agreement_disagreement_uncertainty", "clustering", "ai_provenance", "publication_decision", "correction_status", "availability_status", "history", "homepage_eligible", "archive_date", "captured_fixture"],
  "properties": {
    "cluster_id": {"type": "string", "pattern": "^ccc-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "public_title": {"type": "string", "minLength": 8},
    "discussion_statement": {"type": "string", "minLength": 20},
    "date_first_observed": {"type": "string", "format": "date"},
    "date_most_recently_observed": {"type": "string", "format": "date"},
    "principal_source_id": {"type": "string"},
    "linked_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "primary_theme": {"type": ["string", "null"]},
    "secondary_themes": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "geographies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["academic-research", "policy-and-institutions", "news-and-analysis", "blogs-and-commentary", "data-and-tools", "bluesky"]}},
    "principal_source_role": {"type": "string"},
    "summary": {"type": "string", "minLength": 30},
    "reason_for_relevance": {"type": "string", "minLength": 20},
    "limitations": {"type": "string", "minLength": 10},
    "agreement_disagreement_uncertainty": {"type": "string", "minLength": 10},
    "clustering": {"type": "object", "additionalProperties": false, "required": ["confidence", "rationale", "method", "version", "supporting_identifiers", "principal_source_rationale"], "properties": {"confidence": {"type": "number", "minimum": 0, "maximum": 1}, "rationale": {"type": "string"}, "method": {"type": "string"}, "version": {"type": "string"}, "supporting_identifiers": {"type": "array", "items": {"type": "string"}}, "principal_source_rationale": {"type": "string"}}},
    "ai_provenance": {"type": "object", "additionalProperties": false, "required": ["used", "model", "prompt_version", "run_id"], "properties": {"used": {"type": "boolean"}, "model": {"type": ["string", "null"]}, "prompt_version": {"type": "string"}, "run_id": {"type": "string"}}},
    "publication_decision": {"enum": ["published", "withheld", "quarantined", "archived"]},
    "correction_status": {"enum": ["none", "corrected", "removal-requested", "removed"]},
    "availability_status": {"enum": ["available", "degraded", "unavailable", "under-review"]},
    "history": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["date", "action", "note"], "properties": {"date": {"type": "string", "format": "date"}, "action": {"enum": ["created", "source-added", "source-removed", "merged", "split", "principal-changed", "corrected", "archived"]}, "note": {"type": "string"}}}},
    "homepage_eligible": {"type": "boolean"},
    "archive_date": {"type": ["string", "null"], "format": "date"},
    "captured_fixture": {"type": "boolean"}
  }
}
