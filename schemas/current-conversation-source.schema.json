{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-conversation-source.schema.json",
  "title": "Current Conversations source",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "title", "original_url", "canonical_url", "stable_identifier", "authors_or_organisation", "publication_date", "retrieval_timestamp", "source_environment", "source_type", "source_role", "publisher_or_platform", "source_domain", "language", "geographies", "evidence_basis", "evidence_limitations", "content_access_status", "content_hash", "discovery", "ai_annotation", "risk_flags", "correction_status", "availability_status", "review", "lab_affiliated", "mdpi_excluded", "captured_fixture"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^ccs-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 5},
    "original_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "stable_identifier": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
    "authors_or_organisation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "publication_date": {"type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"},
    "retrieval_timestamp": {"type": "string", "format": "date-time"},
    "source_environment": {"enum": ["academic-research", "policy-and-institutions", "news-and-analysis", "blogs-and-commentary", "data-and-tools", "bluesky"]},
    "source_type": {"type": "string", "minLength": 3},
    "source_role": {"enum": ["primary-research", "official-policy-source", "official-announcement", "dataset-or-tool", "news-reporting", "independent-analysis", "research-commentary", "practitioner-commentary", "public-discussion"]},
    "publisher_or_platform": {"type": "string", "minLength": 2},
    "source_domain": {"type": "string", "minLength": 3},
    "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
    "geographies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence_basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["metadata-only", "abstract", "licensed-full-text", "official-webpage-body", "report-executive-summary", "permitted-excerpt", "data-or-tool-description", "bluesky-post", "linked-source", "search-annotation"]}},
    "evidence_limitations": {"type": "string", "minLength": 10},
    "content_access_status": {"enum": ["substantive", "limited", "metadata-only", "inaccessible"]},
    "content_hash": {"type": ["string", "null"]},
    "discovery": {"$ref": "#/$defs/discovery"},
    "ai_annotation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ai"}]},
    "risk_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "correction_status": {"enum": ["none", "corrected", "removal-requested", "removed"]},
    "availability_status": {"enum": ["available", "redirected", "changed", "unavailable", "under-review"]},
    "review": {"$ref": "#/$defs/review"},
    "lab_affiliated": {"type": "boolean"},
    "mdpi_excluded": {"type": "boolean"},
    "captured_fixture": {"type": "boolean"}
  },
  "$defs": {
    "identifier": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"type": "string"}, "value": {"type": "string"}}},
    "discovery": {"type": "object", "additionalProperties": false, "required": ["adapter", "query_id", "query_version", "run_id"], "properties": {"adapter": {"type": "string"}, "query_id": {"type": "string"}, "query_version": {"type": "string"}, "run_id": {"type": "string"}}},
    "ai": {"type": "object", "additionalProperties": false, "required": ["model", "prompt_version", "summary", "reason_for_relevance"], "properties": {"model": {"type": "string"}, "prompt_version": {"type": "string"}, "summary": {"type": "string"}, "reason_for_relevance": {"type": "string"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer", "reviewed_date", "edits"], "properties": {"status": {"enum": ["not-reviewed", "reviewed"]}, "reviewer": {"type": ["string", "null"]}, "reviewed_date": {"type": ["string", "null"], "format": "date"}, "edits": {"type": "array", "items": {"type": "string"}}}}
  }
}
