{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Person record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "role", "affiliation", "bio", "email", "links", "themes", "placeholder", "owner_review_required"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 2},
    "role": {"type": "string", "minLength": 3},
    "affiliation": {"type": "string", "minLength": 5},
    "bio": {"type": "string", "minLength": 20},
    "email": {"type": ["string", "null"], "format": "email"},
    "links": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": {"label": {"type": "string"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}}},
    "themes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "placeholder": {"type": "boolean"},
    "owner_review_required": {"type": "boolean"}
  }
}
