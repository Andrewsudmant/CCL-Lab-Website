{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public person record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "academic_title", "institutional_affiliation", "lab_role", "display_lines", "short_bio", "full_bio", "email", "office", "telephone", "orcid", "ipcc_role", "ipcc_chapter_title", "education", "previous_affiliation", "profile_links", "image", "image_rights_status", "themes", "last_verified_date", "authoritative_sources", "verification_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 2},
    "academic_title": {"type": "string", "minLength": 3},
    "institutional_affiliation": {"type": "string", "minLength": 5},
    "lab_role": {"type": "string", "minLength": 3},
    "display_lines": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
    "short_bio": {"type": "string", "minLength": 80},
    "full_bio": {"type": "string", "minLength": 300},
    "email": {"type": "string", "format": "email"},
    "office": {"type": "string"},
    "telephone": {"type": "string"},
    "orcid": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"},
    "ipcc_role": {"type": "string"},
    "ipcc_chapter_title": {"type": "string"},
    "education": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["degree", "field", "institution"], "properties": {"degree": {"type": "string"}, "field": {"type": "string"}, "institution": {"type": "string"}}}},
    "previous_affiliation": {"type": "string"},
    "profile_links": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "url", "verified_date"], "properties": {"label": {"type": "string"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "verified_date": {"type": "string", "format": "date"}}}},
    "image": {"type": ["string", "null"]},
    "image_rights_status": {"enum": ["owner-supplied", "licensed", "permission-confirmed", "not-supplied"]},
    "themes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "last_verified_date": {"type": "string", "format": "date"},
    "authoritative_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "verification_status": {"enum": ["owner-approved", "verified", "partially-verified"]}
  },
  "$defs": {"source": {"type": "object", "additionalProperties": false, "required": ["label", "url", "retrieved_date"], "properties": {"label": {"type": "string"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "retrieved_date": {"type": "string", "format": "date"}}}}
}
