{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical project record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "title", "status", "summary", "research_questions", "start_date", "end_date", "primary_theme", "secondary_themes", "geographies", "governance_scales", "methods", "climate_domains", "sectors", "collaborators", "connected_publications", "outputs", "data_tools", "authoritative_sources", "placeholder", "owner_review_required"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 8},
    "status": {"enum": ["planned", "active", "completed", "on-hold", "status-unconfirmed"]},
    "summary": {"type": "string", "minLength": 40},
    "research_questions": {"type": "array", "items": {"type": "string", "minLength": 12}, "maxItems": 6},
    "start_date": {"type": ["string", "null"], "format": "date"},
    "end_date": {"type": ["string", "null"], "format": "date"},
    "primary_theme": {"type": "string"},
    "secondary_themes": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "governance_scales": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "methods": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "climate_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "sectors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "collaborators": {"type": "array", "items": {"type": "string"}},
    "connected_publications": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"type": ["string", "null"], "format": "uri"}}}},
    "data_tools": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}}},
    "authoritative_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["label", "url", "retrieved_date"], "properties": {"label": {"type": "string"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "retrieved_date": {"type": "string", "format": "date"}}}},
    "placeholder": {"type": "boolean"},
    "owner_review_required": {"type": "boolean"}
  }
}
