{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected publication theme examples",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviewed_date", "policy", "records"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "reviewed_date": {"type": "string", "format": "date"},
    "policy": {"type": "string", "minLength": 40},
    "records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "primary_theme", "secondary_themes", "theme_relationships"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "primary_theme": {"type": "string"},
          "secondary_themes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "theme_relationships": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["theme_id", "relationship", "rationale", "evidence_source"],
              "properties": {
                "theme_id": {"type": "string"},
                "relationship": {"enum": ["primary", "secondary"]},
                "rationale": {"type": "string", "minLength": 30},
                "evidence_source": {"type": "string", "format": "uri", "pattern": "^https://"}
              }
            }
          }
        }
      }
    }
  }
}
