{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Watch query pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_pack_id", "version", "maximum_lookback_days", "result_limit_per_query", "global_exclusions", "source_queries", "controls"],
  "properties": {
    "query_pack_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "maximum_lookback_days": {"type": "integer", "minimum": 1, "maximum": 90},
    "result_limit_per_query": {"type": "integer", "minimum": 1, "maximum": 50},
    "global_exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_queries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openalex", "crossref", "openai_web_search", "bluesky"],
      "properties": {
        "openalex": {"$ref": "#/$defs/queries"},
        "crossref": {"$ref": "#/$defs/queries"},
        "openai_web_search": {"$ref": "#/$defs/queries"},
        "bluesky": {"$ref": "#/$defs/queries"}
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": {"type": ["integer", "number"]},
      "minProperties": 8
    }
  },
  "$defs": {
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "themes", "query"],
        "properties": {
          "id": {"type": "string"},
          "themes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "query": {"type": "string", "minLength": 8}
        }
      }
    }
  }
}
