{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research idea",
  "type": "object",
  "additionalProperties": false,
  "required": ["idea_id", "theme_id", "working_title", "question", "problem_of_understanding", "why_it_may_matter", "possible_research_design", "suggested_methods", "possible_geographies", "possible_sectors", "possible_climate_domains", "display_order", "owner_review_status", "disclaimer"],
  "properties": {
    "idea_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "theme_id": {"type": "string"},
    "working_title": {"type": "string", "minLength": 5},
    "question": {"type": "string", "minLength": 20},
    "problem_of_understanding": {"type": "string", "minLength": 35},
    "why_it_may_matter": {"type": "string", "minLength": 35, "maxLength": 360},
    "possible_research_design": {"type": "string", "minLength": 50},
    "suggested_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "possible_geographies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "possible_sectors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "possible_climate_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "display_order": {"type": "integer", "minimum": 1},
    "owner_review_status": {"enum": ["draft-owner-review", "owner-approved", "withheld"]},
    "required_qualification": {"type": "string", "minLength": 40},
    "required_boundary": {"type": "string", "minLength": 40},
    "disclaimer": {"const": "Research idea · not currently an active or funded project"}
  }
}
