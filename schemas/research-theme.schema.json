{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-theme.schema.json",
  "title": "Research theme",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "portfolio_maturity", "guiding_question", "definition", "cycle_role", "included_questions", "exclusions", "initial_search_concepts", "geographical_priorities", "methodological_interests", "representative_placeholder_examples"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 8},
    "portfolio_maturity": {
      "enum": ["established", "developing"],
      "description": "Internal portfolio-planning metadata. It describes the maturity of projects and outputs, not the intellectual status or public importance of the theme."
    },
    "guiding_question": {"type": "string", "minLength": 20},
    "definition": {"type": "string", "minLength": 40},
    "cycle_role": {"type": "string", "minLength": 20},
    "included_questions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 12}},
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 12}},
    "initial_search_concepts": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 4}},
    "geographical_priorities": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 2}},
    "methodological_interests": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 4}},
    "representative_placeholder_examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "placeholder"],
        "properties": {
          "title": {"type": "string", "pattern": "^PLACEHOLDER"},
          "placeholder": {"const": true}
        }
      }
    }
  }
}
