{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-watch.schema.json",
  "title": "Research Watch record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "title", "url", "canonical_url", "stable_identifier", "platform_identifier", "authors_or_organisation", "source_type", "source_name", "source_domain", "publication_date", "retrieval_timestamp", "discovery", "theme_assignments", "geographies", "short_summary", "reason_for_relevance", "novelty_significance", "evidence_basis", "ai_provenance", "confidence", "review", "publication", "reviewer_edits", "risk_flags", "correction_availability", "event_cluster_id", "linked_sources", "captured_fixture"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 8},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "stable_identifier": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["type", "value", "url"], "properties": {"type": {"enum": ["doi", "isbn", "issn", "handle", "arxiv", "report-number", "dataset-id", "post-uri", "openalex", "other"]}, "value": {"type": "string", "minLength": 2}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}}]},
    "platform_identifier": {"type": ["string", "null"]},
    "authors_or_organisation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "source_type": {"enum": ["academic-paper", "policy-report", "news-analysis", "blog-commentary", "data-tool", "bluesky"]},
    "source_name": {"type": "string", "minLength": 2},
    "source_domain": {"type": "string", "minLength": 3},
    "publication_date": {"type": "string", "format": "date"},
    "retrieval_timestamp": {"type": "string", "format": "date-time"},
    "discovery": {"type": "object", "additionalProperties": false, "required": ["run_id", "adapter", "query_id", "query_version"], "properties": {"run_id": {"type": "string"}, "adapter": {"enum": ["openalex", "crossref", "openai-web-search", "bluesky", "captured-fixture"]}, "query_id": {"type": "string"}, "query_version": {"type": "string"}}},
    "theme_assignments": {"type": "object", "additionalProperties": false, "required": ["primary", "secondary"], "properties": {"primary": {"$ref": "#/$defs/themeAssignment"}, "secondary": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/themeAssignment"}}}},
    "geographies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "short_summary": {"type": "string", "minLength": 30, "maxLength": 900},
    "reason_for_relevance": {"type": "string", "minLength": 25, "maxLength": 700},
    "novelty_significance": {"type": "string", "minLength": 15, "maxLength": 500},
    "evidence_basis": {"type": "object", "additionalProperties": false, "required": ["types", "description", "sufficient_for_summary", "limitations"], "properties": {"types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["metadata-only", "abstract", "full-text", "webpage-body", "permitted-excerpt", "search-snippet", "bluesky-post", "linked-source", "dataset-documentation"]}}, "description": {"type": "string", "minLength": 12}, "sufficient_for_summary": {"type": "boolean"}, "limitations": {"type": "string", "minLength": 8}}},
    "ai_provenance": {"type": "object", "additionalProperties": false, "required": ["used", "model", "prompt_version", "run_id", "structured_output_version", "deterministic_transformations"], "properties": {"used": {"type": "boolean"}, "model": {"type": ["string", "null"]}, "prompt_version": {"type": ["string", "null"]}, "run_id": {"type": "string"}, "structured_output_version": {"type": "string"}, "deterministic_transformations": {"type": "array", "items": {"type": "string"}}}},
    "confidence": {"type": "object", "additionalProperties": false, "required": ["score", "label", "basis"], "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}, "label": {"enum": ["low", "medium", "high"]}, "basis": {"type": "string", "minLength": 12}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer", "reviewed_date", "notes"], "properties": {"status": {"enum": ["not_reviewed", "reviewed"]}, "reviewer": {"type": ["string", "null"]}, "reviewed_date": {"type": ["string", "null"], "format": "date"}, "notes": {"type": ["string", "null"]}}},
    "publication": {"type": "object", "additionalProperties": false, "required": ["decision", "reasons", "checks_passed", "disclosure_version"], "properties": {"decision": {"enum": ["published", "withheld", "quarantined"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "checks_passed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "disclosure_version": {"const": "research-watch-disclosure-v1"}}},
    "reviewer_edits": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["field", "description"], "properties": {"field": {"type": "string"}, "description": {"type": "string", "minLength": 5}}}},
    "risk_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["title-only", "limited-evidence", "paywalled", "copyright", "personal-data", "conflict-of-interest", "lab-affiliated-output", "source-credibility", "possible-duplicate", "prompt-injection", "sensitive-content", "suspicious-url", "unsupported-claim", "scope-ambiguity", "none"]}},
    "correction_availability": {"type": "object", "additionalProperties": false, "required": ["status", "date", "note"], "properties": {"status": {"enum": ["available", "corrected", "removed", "link-unavailable", "under-review", "archived"]}, "date": {"type": ["string", "null"], "format": "date"}, "note": {"type": ["string", "null"]}}},
    "event_cluster_id": {"type": ["string", "null"]},
    "linked_sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["relationship", "url"], "properties": {"relationship": {"enum": ["original-source", "commentary", "coverage", "dataset", "tool", "related"]}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}}},
    "captured_fixture": {"type": "boolean"}
  },
  "$defs": {
    "themeAssignment": {"type": "object", "additionalProperties": false, "required": ["theme_id", "score", "rationale"], "properties": {"theme_id": {"type": "string"}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "rationale": {"type": "string", "minLength": 15}}}
  }
}
