{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated theme-page examples",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviewed_date", "policy", "entries"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "reviewed_date": {"type": "string", "format": "date"},
    "policy": {"type": "string", "minLength": 80},
    "entries": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme_id", "record_type", "record_id", "conceptual_grouping", "contribution", "evidence_reviewed"],
        "properties": {
          "theme_id": {"type": "string"},
          "record_type": {"enum": ["work", "publication"]},
          "record_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "conceptual_grouping": {"type": "string", "minLength": 12},
          "contribution": {"type": "string", "minLength": 80, "maxLength": 430},
          "qualification": {"type": "string", "minLength": 30, "maxLength": 220},
          "evidence_reviewed": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uri", "pattern": "^https://"}
          }
        }
      }
    }
  }
}
