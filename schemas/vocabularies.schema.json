{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled vocabularies",
  "type": "object",
  "additionalProperties": false,
  "required": ["vocabulary_version", "geographies", "governance_scales", "methods", "climate_domains", "sectors", "source_types"],
  "properties": {
    "vocabulary_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "geographies": {"$ref": "#/$defs/vocabulary"},
    "governance_scales": {"$ref": "#/$defs/vocabulary"},
    "methods": {"$ref": "#/$defs/vocabulary"},
    "climate_domains": {"$ref": "#/$defs/vocabulary"},
    "sectors": {"$ref": "#/$defs/vocabulary"},
    "source_types": {"$ref": "#/$defs/vocabulary"}
  },
  "$defs": {
    "vocabulary": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "additionalProperties": {"type": "string", "minLength": 2}}
  }
}
